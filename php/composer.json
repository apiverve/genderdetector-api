    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "genderdetector",
        "gender api",
        "gender detection api",
        "gender prediction api",
        "gender checker api",
        "gender classification api"
    ],
    "homepage": "https://apiverve.com/marketplace/genderdetector?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/genderdetector",
        "source": "https://github.com/apiverve/genderdetector-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Genderdetector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Genderdetector\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
